{
  "name": "pivot",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.3"
  },
  "scripts": {
    "dev": "next dev",
    "dev:sqlite": "node scripts/run-local-sqlite.mjs dev",
    "build": "next build",
    "start": "next start",
    "start:sqlite": "node scripts/run-local-sqlite.mjs start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "release-kit": "github:n8watkins/release-kit#v2.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
