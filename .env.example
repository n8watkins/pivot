# Local SQLite-compatible persistence.
TURSO_DATABASE_URL=file:./data/pivot.db

# Optional for remote Turso deployments.
# TURSO_AUTH_TOKEN=
# Keep deterministic recommendations enabled until the AI path is intentionally released.
ENABLE_GEMINI_RECOMMENDATIONS=false
# GEMINI_API_KEY=

# Optional GitHub account upgrade through Auth.js.
# Generate AUTH_SECRET with: npx auth secret
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Local production-like runs set this automatically.
# COOKIE_SECURE=false

# Never enable this for a real deployment.
# ALLOW_IN_MEMORY_PERSISTENCE=false
