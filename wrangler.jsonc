{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Pivot on Cloudflare Workers: the Next.js app built with OpenNext
  // (`npm run build:worker`), plus the hourly check-in Cron Trigger in
  // worker/handlers.ts.
  "name": "pivot",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat is required by @opennextjs/cloudflare, and web-push uses node:crypto and node:https.
  "compatibility_flags": ["nodejs_compat"],
  // No custom domain yet: the app is served at pivot.<account>.workers.dev
  // until the owner picks one (see README "Hosting").
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Hourly at :07, as the GitHub Actions schedule was: /api/cron/notifications
  // sends the check-ins that are due at 09:00 in each subscriber's timezone.
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "vars": {
    "WEB_PUSH_SUBJECT": "mailto:nathancwatkins23@gmail.com"
  }
  // Secrets are set with `wrangler secret put <NAME>`, never in this file.
  // .dev.vars.example lists them (and generates their binding types); local
  // workerd runs read real values from .dev.vars.
}
