{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Pivot on Cloudflare Workers: the Next.js app built with OpenNext
  // (`npm run build:worker`), plus the hourly check-in Cron Trigger in
  // worker/handlers.ts.
  "name": "pivot",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat is required by @opennextjs/cloudflare, and web-push uses node:crypto and node:https.
  "compatibility_flags": ["nodejs_compat"],
  // Served at https://pivot.n8builds.dev (a custom domain attached to this
  // Worker in the dashboard). The workers.dev address is off, so all traffic
  // goes through the zone (bot rules, cache).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Hourly at :07, as the GitHub Actions schedule was: /api/cron/notifications
  // sends the check-ins that are due at 09:00 in each subscriber's timezone.
  "triggers": {
    "crons": ["7 * * * *"]
  },
  // Workers Cache (worker/edge-cache.ts): Cloudflare's cache sits in front of the
  // CachedPages entrypoint, so a static page costs no CPU time once cached. The default
  // entrypoint runs on every request and sends only page views there.
  "cache": { "enabled": false },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "CachedPages": { "type": "worker", "cache": { "enabled": true } }
  },
  "vars": {
    // The canonical origin: Auth.js builds its callback URLs from it.
    "AUTH_URL": "https://pivot.n8builds.dev",
    "WEB_PUSH_SUBJECT": "mailto:nathancwatkins23@gmail.com",
    // Server errors go to Sentry (worker/sentry.ts). A DSN is public by design:
    // it only lets a sender add events to this one project.
    "SENTRY_DSN": "https://c1531709f2591d04e6f05afc93750d68@o4507767562371072.ingest.us.sentry.io/4512375297343488"
  }
  // Secrets are set with `wrangler secret put <NAME>`, never in this file.
  // .dev.vars.example lists them (and generates their binding types); local
  // workerd runs read real values from .dev.vars.
}
